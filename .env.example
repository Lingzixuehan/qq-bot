# NoneBot2 配置
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
SUPERUSERS=["123456789"]  # 超级管理员QQ号列表

# OneBot 配置
ONEBOT_ACCESS_TOKEN=""  # 如果NapCat设置了token，填写在这里

# 命令前缀（只允许 / 开头的命令，避免误触发）
COMMAND_START=["/"]  # 命令前缀，必须使用 /help 格式
COMMAND_SEP=[" "]  # 命令分隔符

# Steam API配置
STEAM_API_KEY=""  # Steam Web API Key，申请地址: https://steamcommunity.com/dev/apikey
ITAD_API_KEY=""  # IsThereAnyDeal API Key（可选），申请地址: https://isthereanydeal.com/apps/
                 # 用于史低价格查询、游戏折扣等功能，不配置则部分功能受限

# Steam自动播报配置（可选）
STEAM_BROADCAST_ENABLED=true  # 是否启用自动播报功能（默认true）
STEAM_BROADCAST_INTERVAL=300  # 播报检测间隔（秒），默认300秒（5分钟）
                               # 注意：启用后会自动推送Steam促销活动（每天10:00检查）

# 二次元美图API配置
ANIME_PIC_API="lolicon"  # 可选值: loli, safebooru, lolicon, danbooru
# 默认API源（不指定参数时使用），推荐 lolicon
# loli: LoliAPI，简单稳定，699+图片，不支持标签搜索
# safebooru: Safebooru API，默认过滤(rating:safe score:>=10)，支持标签搜索
# lolicon: Lolicon API，Pixiv源，支持中英文标签，图片质量高（推荐）
# danbooru: Danbooru API，海量图片，支持英文标签搜索
# 💡 也可以在命令中指定API源，如：/美图 safebooru

# 搜图功能频率限制（可选）
# 格式：群号:次数/小时,群号:次数/小时
# 示例：SEARCH_PIC_RATE_LIMIT_GROUPS="123456789:5,987654321:3"
# 表示：群123456789每小时限制5次，群987654321每小时限制3次
# 留空表示不限制
SEARCH_PIC_RATE_LIMIT_GROUPS=""

# 搜图白名单（可选）
# 格式：QQ号,QQ号,QQ号
# 示例：SEARCH_PIC_WHITELIST="123456,789012,345678"
# 白名单用户不受频率限制
SEARCH_PIC_WHITELIST=""

# 群聊消息缓冲（可选）
# 启用该功能的群号列表，逗号分隔，留空表示关闭
GROUP_BUFFER_GROUPS=""
# 缓冲时间窗口（秒），默认30秒
GROUP_BUFFER_INTERVAL=30

# 消息过滤配置（可选）- 基于功能区分是否缓冲
#
# 只缓冲这些功能：只有包含这些关键词的消息会被缓冲，其他消息立即发送
# 多个关键词用逗号分隔，留空表示缓冲所有消息
# 示例：GROUP_BUFFER_INCLUDE_KEYWORDS="Steam,促销,美图,搜图,搜番"
# 适用场景：只想缓冲某些查询类功能，其他功能消息（如游戏、错误提示）正常发送
GROUP_BUFFER_INCLUDE_KEYWORDS=""

# 不缓冲这些功能：包含这些关键词的消息不会被缓冲，立即发送
# 多个关键词用逗号分隔，留空表示不排除任何消息
# 示例：GROUP_BUFFER_EXCLUDE_KEYWORDS="错误,失败,审判,转盘,禁言"
# 适用场景：大部分消息都缓冲，但某些重要/游戏类消息需要立即看到
# 注意：此配置优先级高于 INCLUDE_KEYWORDS
GROUP_BUFFER_EXCLUDE_KEYWORDS=""

# ============== 趣味游戏配置 ==============

# 魔女审判配置
WITCH_TRIAL_BAN_DURATION=60      # 审判通过后的禁言时长（秒），默认60秒
WITCH_TRIAL_VOTE_TIME=60         # 投票时间（秒），默认60秒
WITCH_TRIAL_COOLDOWN=300         # 同一群内发起审判的冷却时间（秒），默认300秒（5分钟）
WITCH_TRIAL_MIN_VOTES=3          # 通过审判所需的最少投票数，默认3票

# 禁言大转盘配置
ROULETTE_DURATIONS="10,30,60,120,300,600"  # 转盘时间选项（秒），逗号分隔
                                            # 默认：10秒,30秒,1分钟,2分钟,5分钟,10分钟
ROULETTE_COOLDOWN=60             # 同一用户使用转盘的冷却时间（秒），默认60秒

# 俄罗斯轮盘配置
RUSSIAN_ROULETTE_BAN_DURATION=60 # 中弹后的禁言时长（秒），默认60秒
