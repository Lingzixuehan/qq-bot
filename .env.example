# NoneBot2 配置
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
SUPERUSERS=["123456789"]  # 超级管理员QQ号列表

# OneBot 配置
ONEBOT_ACCESS_TOKEN=""  # 如果NapCat设置了token，填写在这里

# 命令前缀（只允许 / 开头的命令，避免误触发）
COMMAND_START=["/"]  # 命令前缀，必须使用 /help 格式
COMMAND_SEP=[" "]  # 命令分隔符

# Steam API配置
STEAM_API_KEY=""  # Steam Web API Key，申请地址: https://steamcommunity.com/dev/apikey

# 二次元美图API配置
ANIME_PIC_API="loli"  # 可选值: loli (LoliAPI) 或 danbooru (Danbooru API)
# loli: 简单稳定，699+图片，不支持标签搜索
# danbooru: 海量图片，支持标签搜索，需要网络畅通
